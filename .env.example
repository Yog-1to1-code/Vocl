GEMINI_API_KEY=your-api-key-here
# true = offline mock System 1/2 (no API calls); false in production
USE_MOCK_AI=false
# "prod" = full Staff Engineer persona (default); "test" = same persona with eager first-approach tool trigger
PROMPT_MODE=prod
GEMINI_LIVE_MODEL=gemini-3.8-live
# Swap GEMINI_REASONING_MODEL to gemini-4-hydrogen (or target reasoning model) via Cloud Run env vars
GEMINI_REASONING_MODEL=gemini-3.1-flash-lite
SYSTEM2_TIMEOUT_SEC=3.0
CSV_PATH=data/sessions.csv
DATABASE_URL=sqlite+aiosqlite:///./data/vocl.db

# Auth & per-user daily quota
JWT_SECRET_KEY=replace-with-32-byte-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168
GOOGLE_CLIENT_ID=
DEV_AUTH_BYPASS=true
DAILY_QUOTA_MINUTES=15.0
